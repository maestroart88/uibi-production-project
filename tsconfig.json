{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "target": "es5",
    "jsx": "react-jsx",
    "allowJs": true,
    // 
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "ts-node": {
